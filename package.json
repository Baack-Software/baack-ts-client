{
  "name": "@baack-software/baack-ts-client",
  "version": "0.0.4",
  "description": "Official TypeScript client for Baack.co Headless CMS",
  "keywords": [
    "cms",
    "headless-cms",
    "content-management",
    "dxp",
    "digital-experience-platform",
    "crm",
    "project-management",
    "tasks",
    "communities",
    "chat",
    "message-threads",
    "typescript",
    "api-client"
  ],
  "homepage": "https://github.com/Baack-Software/baack-ts-client#readme",
  "bugs": {
    "url": "https://github.com/Baack-Software/baack-ts-client/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baack-Software/baack-ts-client.git"
  },
  "license": "Apache-2.0",
  "author": "baack-dakkad",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc",
    "test": "npm run build && tsc -p test/types && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "module": "dist/index.js",
  "publishConfig": {
    "access": "public"
  }
}
